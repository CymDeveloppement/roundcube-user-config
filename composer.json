{
    "name": "cymdeveloppement/ude-login",
    "type": "roundcube-plugin",
    "description": "Allows to specify configuration settings such as IMAP/SMTP servers, active plugins, etc. on a per-user level using a static text file.",
    "keywords": ["roundcube", "roundcube-plugin", "authentication", "settings", "imap", "smtp"],
    "homepage": "https://github.com/CymDeveloppement/roundcube-ude-login",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Thomas Bruederli",
            "email": "bruederli@kolabsys.com",
            "role": "Original author"
        },
        {
            "name": "Yann Challet",
            "homepage": "https://github.com/CymDeveloppement",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": ">=8.0",
        "roundcube/plugin-installer": ">=0.3.0"
    },
    "extra": {
        "roundcube": {
            "min-version": "1.6.0"
        }
    }
}
